# Copy this file to .env and fill in the keys you actually use.
# Never commit the real .env file.

# --- LLM providers (only fill in the one(s) set in config.yaml) ---
# Local inference (ollama) needs no key. Everything else is optional.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Home Assistant (used by the Home agent to control Google Home Mini) ---
# Generate a Long-Lived Access Token from your Home Assistant profile page.
# Home Assistant runs on the home server; base_url in config.yaml points at
# its Tailscale MagicDNS name.
HOME_ASSISTANT_TOKEN=

# --- MQTT (Mosquitto, also on the home server) ---
MQTT_PASSWORD=